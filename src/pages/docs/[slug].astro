---
import { Marked } from 'marked';
import Base from '../../layouts/Base.astro';
import { escapeHtml, loadUpstream, UPSTREAM_GITHUB, type Doc } from '../../lib/upstream';
import { SITE_NAME, appPath, clip, docPath, href } from '../../lib/site';

export async function getStaticPaths() {
  const up = await loadUpstream();
  return up.docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props as { doc: Doc };
const up = await loadUpstream();
const app = up.apps.find((a) => a.docs.includes(doc.slug));

// Links between docs stay on this site; other relative links go to GitHub.
function rewrite(link: string) {
  if (/^[a-z][a-z0-9+.-]*:|^#/i.test(link)) return link;
  const sibling = link.match(/^(?:\.\/)?([^/]+)\.md(#.*)?$/);
  if (sibling && up.docs.some((d) => d.slug === sibling[1])) return href(docPath(sibling[1])) + (sibling[2] ?? '');
  return new URL(link, `${UPSTREAM_GITHUB}/blob/main/${doc.file}`).href;
}

const marked = new Marked({
  gfm: true,
  walkTokens(token) {
    if (token.type === 'link' || token.type === 'image') token.href = rewrite(token.href);
  },
  renderer: {
    // Upstream markdown is rendered as text only; raw HTML is escaped.
    html: ({ text }) => escapeHtml(text),
  },
});

// Drop the leading H1; the layout renders the title.
const body = marked.parse(doc.markdown.replace(/^#\s+.+\n/, ''), { async: false }) as string;
const firstPara = doc.markdown.split(/\n\s*\n/).find((b) => b.trim() && !/^[#|`>-]/.test(b.trim())) ?? doc.title;
const description = clip(firstPara.replace(/[`*_[\]]|\(.*?\)/g, '').replace(/\s+/g, ' ').trim());

const crumbs = [
  { name: SITE_NAME, path: '' },
  ...(app ? [{ name: app.name, path: appPath(app.id) }] : []),
  { name: doc.title, path: docPath(doc.slug) },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: doc.title,
    description,
    dateModified: up.date,
    ...(app && { about: { '@type': 'SoftwareApplication', name: app.name, operatingSystem: 'Linux' } }),
  },
];
---

<Base title={`${doc.title} | ${SITE_NAME}`} description={description} path={docPath(doc.slug)} crumbs={crumbs} jsonLd={jsonLd}>
  <article>
    <h1>{doc.title}</h1>
    <Fragment set:html={body} />
    <p class="meta">Source: <a href={`${UPSTREAM_GITHUB}/blob/main/${doc.file}`}>{doc.file}</a></p>
  </article>
</Base>
